---
import Layout from '../layouts/Layout.astro';
import Papa from 'papaparse';
import csvRaw from '../data/Dance&Dance.csv?raw';

// 1. Obtenemos la categoría directamente de la URL en modo SSR
const { category } = Astro.params;

// Función slugify robusta y universal para tildes y eñes
function slugify(text) {
  if (!text) return "";
  return text
    .toLowerCase()
    .replace(/ñ/g, "n")               // Cambia ñ por n
    .normalize("NFD")                 // Separa las tildes de las letras
    .replace(/[\u0300-\u036f]/g, "") // Elimina las tildes limpiamente
    .replace(/[^a-z0-9 -]/g, "")      // Quita símbolos extraños
    .replace(/\s+/g, "-")             // Cambia espacios por guiones
    .replace(/-+/g, "-");             // Evita guiones dobles
}

// 2. Parseamos y procesamos el CSV en cada petición del servidor
const parsedData = Papa.parse(csvRaw, { header: true, skipEmptyLines: true });
const rawAlbums = parsedData.data;

let validAlbums = rawAlbums.filter(a => a && a.Title && a.Status === "PUBLISHED");

if (category === 'compilations') {
  validAlbums = validAlbums.filter(a => a.Categoría === 'Compilation');
} else if (category === 'playlists') {
  validAlbums = validAlbums.filter(a => a.Categoría === 'Playlist');
} else if (category === 'artist-compilations') {
  validAlbums = validAlbums.filter(a => a.Categoría === 'Artist');
}

const albums = validAlbums.map(a => ({
  ...a,
  slug: slugify(a.Title)
})).filter((a, i, s) => i === s.findIndex((t) => t.Title === a.Title))
.sort((a, b) => {
  const dateA = a.Fecha ? new Date(a.Fecha).getTime() : 0;
  const dateB = b.Fecha ? new Date(b.Fecha).getTime() : 0;
  if (dateB !== dateA) return dateB - dateA;
  return a.Title.localeCompare(b.Title);
});

function obtenerUrlWix(wixString) {
  if (!wixString || !wixString.startsWith('wix:image')) return wixString;
  const partes = wixString.split('/');
  const idImagen = partes[partes.length - 2]; 
  return `https://static.wixstatic.com/media/${idImagen}`;
}

function getDetailUrl(album) {
  if (album.Categoría === 'Compilation') return `/compilations/${album.slug}`;
  if (album.Categoría === 'Playlist') return `/playlists/${album.slug}`;
  if (album.Categoría === 'Artist') return `/artist-compilations/${album.slug}`;
  return `/${album.slug}`;
}

let pageTitle = "All Albums";
if (category === 'compilations') pageTitle = "Compilations";
else if (category === 'playlists') pageTitle = "Playlists";
else if (category === 'artist-compilations') pageTitle = "Artist Compilations";

const albumsPorAno = albums.reduce((acc, album) => {
  let anoCrudo = album.Año && album.Año.trim() !== "" ? album.Año.trim() : (album.Fecha ? new Date(album.Fecha).getFullYear().toString() : 'Other');
  const ano = anoCrudo.replace(/[\[\]"]/g, '').trim();

  if (!acc[ano]) {
    acc[ano] = [];
  }
  acc[ano].push(album);
  return acc;
}, {});

const anosOrdenados = Object.keys(albumsPorAno).sort((a, b) => {
  if (a === 'Other') return 1;
  if (b === 'Other') return -1;
  return Number(b) - Number(a);
});
---

<Layout title={`${pageTitle} | Dance & Dance`}>
  <div class="catalog-container">
    
   <h1 class="page-title">{pageTitle}</h1>

    <!-- 📌 DESPLEGABLE COMPACTO DE AÑOS -->
    {anosOrdenados.length > 1 && (
      <div class="year-select-container">
        <select id="year-jump-dropdown" class="year-dropdown" onchange="if(this.value) { document.getElementById(this.value).scrollIntoView({ behavior: 'smooth' }); }">
          <option value="" disabled selected>Jump to year...</option>
          {anosOrdenados.map(ano => (
            <option value={`year-${ano}`}>{ano}</option>
          ))}
        </select>
      </div>
    )}

    {anosOrdenados.map(ano => (
      <div id={`year-${ano}`} class="year-block">
        <h2 class="year-title">{ano}</h2>

        <div class={category === 'all-albums' ? "albums-flex-grid grid-5-cols-mode" : "albums-flex-grid"}>
          {albumsPorAno[ano].map(album => (
            <a href={getDetailUrl(album)} class="album-card">
              <div class="image-wrapper">
                <img src={obtenerUrlWix(album.Image)} alt={album.Title} loading="lazy" />
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

  </div>
</Layout>

<style is:global>
  /* Desplazamiento suave para que el salto de año no sea brusco */
  html {
    scroll-behavior: smooth;
  }

  .catalog-container {
    max-width: 950px;
    margin: 10px auto 10px auto !important;
    padding: 0 20px;
    font-family: 'Work Sans', sans-serif;
  }

  .page-title {
    font-family: 'Work Sans', sans-serif !important;
    font-size: 74px !important;
    font-style: italic !important;
    font-weight: 400 !important;
    color: #E0DEDE !important;
    margin: 0 0 15px 0 !important;
    text-align: center !important;
    line-height: 0.8em !important;
  }

  /* 📌 ESTILOS DE LA BARRA DE AÑOS SUPERIOR */
  /* Estilos del desplegable de años */
  .year-select-container {
    text-align: center;
    margin-bottom: 30px;
  }

  .year-dropdown {
    font-family: 'Work Sans', sans-serif;
    font-size: 14px;
    font-style: italic;
    padding: 8px 16px;
    background-color: #fafafa;
    border: 1px solid #ccc;
    border-radius: 20px;
    color: #333;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
  }

  .year-dropdown:hover, .year-dropdown:focus {
    border-color: #000;
  }

  .year-jump-bar {
    margin: 0 auto 30px auto;
    max-width: 800px;
    padding: 8px 12px;
    background-color: #fafafa;
    border: 1px solid #eaeaea;
    border-radius: 30px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.03);
  }

  .year-jump-scroll {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    max-height: 120px;
    overflow-y: auto;
  }

  .year-jump-pill {
    display: inline-block;
    padding: 4px 12px;
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #cccccc;
    border-radius: 15px;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .year-jump-pill:hover {
    background-color: #000000;
    color: #ffffff;
    border-color: #000000;
    transform: translateY(-1px);
  }

  .year-block {
    margin-bottom: 25px !important;
    /* Añadimos scroll-margin para compensar la barra fija superior de la web al hacer clic */
    scroll-margin-top: 160px; 
  }

  .year-title {
    font-family: 'Work Sans', sans-serif !important;
    font-size: 28px !important;
    font-style: italic !important;
    font-weight: 600 !important;
    color: #222222 !important;
    margin: 0 0 15px 0 !important;
    padding: 0 !important;
    text-align: center !important;
    border: none !important;
  }

  .albums-flex-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 25px;
    max-width: 950px;
    margin: 0 auto;
  }

  .album-card {
    text-decoration: none;
    color: inherit;
    display: block;
    text-align: center;
    width: 218px; 
  }

  .image-wrapper {
    width: 100%;
    aspect-ratio: 1/1;
    overflow: hidden;
    margin: 0 auto;
    border: 1px solid #000000;
    border-radius: 12px;
    background-color: #fcfcfc;
    transition: transform 0.3s ease;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .album-card:hover .image-wrapper img {
    transform: scale(1.03);
  }

  /* 📱 ADAPTABILIDAD MÓVIL */
  @media (max-width: 768px) {
    .catalog-container {
      padding: 0 10px;
    }

    .page-title {
      font-size: 44px !important;
      margin-bottom: 15px !important;
    }

    .year-jump-bar {
      padding: 6px 8px;
      margin-bottom: 20px;
    }

    .year-jump-scroll {
      max-height: 100px; /* Permite hacer scroll vertical si hay muchos años en móvil */
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .year-jump-pill {
      font-size: 12px;
      padding: 3px 10px;
      flex-shrink: 0;
    }

    .year-title {
      font-size: 22px !important;
      margin-bottom: 12px !important;
    }

    .albums-flex-grid, 
    .albums-flex-grid.grid-5-cols-mode {
      gap: 12px 10px;
    }

    .album-card {
      width: 48% !important;
      max-width: none;
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Papa from 'papaparse';
import csvRaw from '../data/Dance&Dance.csv?raw';

// 1. Detectar automáticamente la categoría según la URL actual
const pathname = Astro.url.pathname;
let category = 'all-albums';
let pageTitle = "All Albums";

if (pathname.includes('/compilations')) {
  category = 'compilations';
  pageTitle = "Compilations";
} else if (pathname.includes('/playlists')) {
  category = 'playlists';
  pageTitle = "Playlists";
} else if (pathname.includes('/artist-compilations')) {
  category = 'artist-compilations';
  pageTitle = "Artist Compilations";
}

// 2. Parsear y filtrar datos del CSV
const parsedData = Papa.parse(csvRaw, { header: true, skipEmptyLines: true });
const rawAlbums = parsedData.data || [];

let validAlbums = rawAlbums.filter(a => a && a.Title && a.Status === "PUBLISHED");

if (category === 'compilations') {
  validAlbums = validAlbums.filter(a => a.Categoría === 'Compilation');
} else if (category === 'playlists') {
  validAlbums = validAlbums.filter(a => a.Categoría === 'Playlist');
} else if (category === 'artist-compilations') {
  validAlbums = validAlbums.filter(a => a.Categoría === 'Artist');
}

const processedAlbums = validAlbums.map(a => ({
  ...a,
  slug: a.Title.toLowerCase().replace(/[^\w ]+/g, '').replace(/ +/g, '-')
})).filter((a, i, s) => i === s.findIndex((t) => t.Title === a.Title))
.sort((a, b) => {
  return (b.Fecha ? new Date(b.Fecha).getTime() : 0) - (a.Fecha ? new Date(a.Fecha).getTime() : 0);
});

function obtenerUrlWix(wixString) {
  if (!wixString || !wixString.startsWith('wix:image')) return wixString;
  const partes = wixString.split('/');
  const idImagen = partes[partes.length - 2]; 
  return `https://static.wixstatic.com/media/${idImagen}`;
}

function getDetailUrl(album) {
  if (album.Categoría === 'Compilation') return `/compilations/${album.slug}`;
  if (album.Categoría === 'Playlist') return `/playlists/${album.slug}`;
  if (album.Categoría === 'Artist') return `/artist-compilations/${album.slug}`;
  return `/${album.slug}`;
}

const safeAlbums = processedAlbums || [];
const albumsPorAno = safeAlbums.reduce((acc, album) => {
  let anoCrudo = album.Año && album.Año.trim() !== "" ? album.Año.trim() : (album.Fecha ? new Date(album.Fecha).getFullYear().toString() : 'Other');
  const ano = anoCrudo.replace(/[\[\]"]/g, '').trim();

  if (!acc[ano]) {
    acc[ano] = [];
  }
  acc[ano].push(album);
  return acc;
}, {});

const anosOrdenados = Object.keys(albumsPorAno).sort((a, b) => {
  if (a === 'Other') return 1;
  if (b === 'Other') return -1;
  return Number(b) - Number(a);
});
---

<Layout title={`${pageTitle} | Dance & Dance`}>
  <div class="catalog-container">
    
    <h1 class="page-title">{pageTitle}</h1>

    {anosOrdenados.map(ano => (
      <div class="year-block">
        <h2 class="year-title">{ano}</h2>

        <div class={category === 'all-albums' ? "albums-flex-grid grid-5-cols-mode" : "albums-flex-grid"}>
          {albumsPorAno[ano].map(album => (
            <a href={getDetailUrl(album)} class="album-card">
              <div class="image-wrapper">
                <img src={obtenerUrlWix(album.Image)} alt={album.Title} loading="lazy" />
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

  </div>
</Layout>

<style is:global>
  .catalog-container {
    max-width: 950px;
    margin: 10px auto 10px auto !important;
    padding: 0 20px;
    font-family: 'Work Sans', sans-serif;
  }

  .page-title {
    font-family: 'Work Sans', sans-serif !important;
    font-size: 74px !important;
    font-style: italic !important;
    font-weight: 400 !important;
    color: #E0DEDE !important;
    margin: 0 0 25px 0 !important;
    text-align: center !important;
    line-height: 0.8em !important;
  }

  .year-block {
    margin-bottom: 20px !important;
  }

  .year-title {
    font-family: 'Work Sans', sans-serif !important;
    font-size: 28px !important;
    font-style: italic !important;
    font-weight: 600 !important;
    color: #222222 !important;
    margin: 0 0 15px 0 !important;
    padding: 0 !important;
    text-align: center !important;
    border: none !important;
  }

 .albums-flex-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 25px;
    max-width: 950px;
    margin: 0 auto;
  }

  .album-card {
    text-decoration: none;
    color: inherit;
    display: block;
    text-align: center;
    width: 218px; 
  }

  .image-wrapper {
    width: 100%;
    aspect-ratio: 1/1;
    overflow: hidden;
    margin: 0 auto;
    border: 1px solid #000000;
    border-radius: 12px;
    background-color: #fcfcfc;
    transition: transform 0.3s ease;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .album-card:hover .image-wrapper img {
    transform: scale(1.03);
  }

  @media (max-width: 768px) {
    .catalog-container {
      padding: 0 10px;
    }
    .page-title {
      font-size: 44px !important;
      margin-bottom: 20px !important;
    }
    .year-title {
      font-size: 22px !important;
      margin-bottom: 12px !important;
    }
    .albums-flex-grid {
      gap: 12px 10px;
    }
    .album-card {
      width: 48% !important;
      max-width: none;
    }
  }
</style>

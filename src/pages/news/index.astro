---
import Layout from '../../layouts/Layout.astro'; // Ajusta la ruta a tu Layout si es distinta

// Petición al feed RSS/JSON público de tu Blogger (pide hasta 150 posts)
const response = await fetch('https://dance-anddance.blogspot.com/feeds/posts/default?alt=json&max-results=150');
const data = await response.json();

// Extraemos las entradas
const entries = data.feed?.entry || [];

// Formateamos los datos que necesitamos de cada entrada
const posts = entries.map((entry: any) => {
  const labels = entry.category ? entry.category.map((cat: any) => cat.term) : [];
  
  return {
    id: entry.id.$t,
    title: entry.title.$t,
    published: entry.published.$t,
    content: entry.content.$t, // HTML del post completo
    labels: labels,
    isCompilation: labels.includes('Compilations'),
    isPlaylist: labels.includes('Playlists')
  };
});
---

<Layout title="News | Dance & Dance">
  <div class="news-container">
    
    <!-- TÍTULO PRINCIPAL -->
    <h1 class="news-main-title">News</h1>

    <div class="posts-list">
      {posts.map((post: any) => (
        <article class={`post-card ${post.isCompilation ? 'layout-compilation' : ''} ${post.isPlaylist ? 'layout-playlist' : ''}`}>
          <header class="post-header">
            <h2 class="post-title">{post.title}</h2>
            <time class="post-date">
              {new Date(post.published).toLocaleDateString('es-ES', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </header>
          
          <!-- Contenido HTML traído de Blogger -->
          <div class="post-content" set:html={post.content} />
        </article>
      ))}
    </div>

  </div>
</Layout>

<style>
  .news-container {
    max-width: 950px;
    margin: 10px auto 10px auto !important;
    padding: 0 20px;
    font-family: 'Work Sans', sans-serif;
    overflow-x: hidden; /* Prevent Blogger content from breaking window scroll */
  }

  .news-main-title {
    font-family: 'Work Sans', sans-serif !important;
    font-size: 74px !important;
    font-style: italic !important;
    font-weight: 400 !important;
    color: #E0DEDE !important;
    margin: 0 0 35px 0 !important;
    text-align: center !important;
    line-height: 0.8em !important;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 25px;
  }

  .post-card {
    background: transparent;
    padding-bottom: 35px;
    border-bottom: 1px solid #333333;
  }

  .post-title {
    font-family: 'Work Sans', sans-serif !important;
    font-size: 24px !important;
    font-weight: 700 !important;
    font-style: italic !important;
    color: #222222 !important;
    margin: 0 0 6px 0 !important;
  }

  .post-date {
    display: block;
    font-size: 0.85rem !important;
    color: #888888 !important;
    margin-bottom: 18px !important;
    font-style: italic;
  }

  /* Formato para el cuerpo de la noticia */
  .post-content {
    font-size: 1rem;
    line-height: 1.5;
    color: #333333;
    overflow-wrap: break-word; /* Prevents long URLs from expanding the width */
  }

  /* Estilos específicos para las etiquetas traídas dinámicamente de Blogger */
  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 10px 0;
  }

  .post-content :global(a) {
    color: inherit;
    text-decoration: underline !important;
  }

  .post-content :global(p:empty),
  .post-content :global(br) {
    display: none;
  }

  /* 📱 ADAPTABILIDAD MÓVIL */
  @media (max-width: 768px) {
    .news-container {
      padding: 0 10px;
    }

    .news-main-title {
      font-size: 44px !important;
      margin-bottom: 25px !important;
    }

    .post-title {
      font-size: 20px !important;
    }

    .posts-list {
      gap: 15px;
    }
  }
</style>

---
// Layout.astro - Estructura definitiva de Dance & Dance
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />

		
		<!-- Carga completa y real de Work Sans -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
		
		<title>{title ? `Dance & Dance / ${title}` : "Dance & Dance"}</title>
	</head>
	<body>

		<!-- CABECERA INTELIGENTE (Se oculta al bajar en móvil y reaparece al subir) -->
		<header id="main-header" style="display: flex; flex-direction: column; align-items: center; padding: 12px 20px 8px 20px; background-color: #ffffff; position: sticky; top: 0; z-index: 1000; transition: transform 0.3s ease-in-out;">
			<div style="margin-bottom: 0px; text-align: center; width: 100%;">
				<a href="/">
					<img 
						src="/Banner-Superior-DD.png" 
						alt="Dance & Dance - Banner Superior" 
						style="max-width: 550px; width: 100%; height: auto; display: block; margin: 0 auto;" 
					/>
				</a>
			</div>
			<nav class="main-nav">
				<a href="/" style="color: #000000;">Home</a>
				<a href="/compilations" style="color: #000000;">Compilations</a>
				<a href="/playlists" style="color: #000000;">Playlists</a>
				<a href="/artist-compilations" style="color: #000000;">Artist Compilations</a>
				<a href="/all-albums" style="color: #000000;">All Albums</a>
				<a href="/more-playlists" style="color: #000000;">+ Playlists</a>
			</nav>
		</header>

		<!-- CONTENIDO PRINCIPAL -->
		<main style="max-width: 1200px; margin: 0 auto; padding: 5px 40px 5px 40px;">
			<slot />
		</main>

		<!-- BOTÓN FLOTANTE "VOLVER ARRIBA" (PC y Móvil) -->
		<button id="scroll-to-top" aria-label="Volver arriba" title="Volver arriba">
			&#8593;
		</button>

		<!-- PIE DE PÁGINA -->
		<footer class="main-footer">
			<div class="footer-content">
				
				<div class="footer-col-left">
					<p style="margin: 0 0 8px 0;">
						<img src="/D&D-Logo.png" alt="Dance & Dance Logo" style="max-width: 110px; width: 100%; height: auto; display: block;" />
					</p>
					<p style="margin: 0; white-space: nowrap;">&copy; 2016 - 2026 by Dance & Dance.</p>
				</div>
				
				<div class="footer-col-right">
					<p class="footer-phrase-1">
						Dance & Dance <span style="color: #ff1616;">100%</span> Dance Music
					</p>

					<p class="footer-phrase-2">
						Los mejores éxitos actuales y clásicos del dance
					</p>
					
					<div class="footer-icons">
						<a href="https://open.spotify.com/user/danceanddance2016?si=4cb3eb62b3a24436" target="_blank" title="Spotify">
							<img src="/images/Spotify_Primary_Logo_RGB_Green (1).png" alt="Spotify" style="height: 30px; width: 30px; object-fit: contain; display: block;" />
						</a>
						<a href="https://www.deezer.com/es/profile/1501757982" target="_blank" title="Deezer">
							<img src="/images/Heart Icon.png" alt="Deezer" style="height: 30px; width: 30px; object-fit: contain; display: block;" />
						</a>
						<a href="https://music.youtube.com/channel/UC__u35D1H0NgsgPHb6OnPZQ?feature=share" target="_blank" title="YouTube Music">
							<img src="/images/YouTubeMusic_Logo.png" alt="YouTube Music" style="height: 30px; width: 30px; object-fit: contain; display: block;" />
						</a>
						<a href="https://www.youtube.com/channel/UC__u35D1H0NgsgPHb6OnPZQ/featured" target="_blank" title="YouTube">
							<img src="/images/logo-mini-youtube.png" alt="YouTube" style="height: 30px; width: 30px; object-fit: contain; display: block;" />
						</a>
						<a href="https://www.facebook.com/Dance-Dance-402811826731310/" target="_blank" title="Facebook">
							<img src="images/Facebook_Logo_Primary.png" alt="Facebook" style="height: 30px; width: 30px; object-fit: contain; display: block;" />
						</a>
						<a href="https://twitter.com/Dance_Y_Dance" target="_blank" title="X">
							<img src="/images/logo-black.png" alt="X" style="height: 28px; width: 28px; object-fit: contain; display: block;" />
						</a>
						<a href="https://www.instagram.com/danceanddance2016/" target="_blank" title="Instagram">
							<img src="/images/Instagram_logo.png" alt="Instagram" style="height: 30px; width: 30px; object-fit: contain; border-radius: 8px; display: block;" />
						</a>
						<a href="https://soundcloud.com/dance-dance-844343366" target="_blank" title="SoundCloud">
							<img src="/images/soudcloudd_Favicon Colors Black on orange.png" alt="SoundCloud" style="height: 30px; width: 30px; object-fit: contain; border-radius: 6px; display: block;" />
						</a>
					</div>
				</div>

			</div>
		</footer>

		<!-- SCRIPTS INTELIGENTES -->
		<script>
			let lastScrollTop = 0;
			const header = document.getElementById('main-header');
			const scrollTopBtn = document.getElementById('scroll-to-top');
			const scrollThreshold = 50;
			let scrollTimeout;

			window.addEventListener('scroll', function() {
				let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

				// 1. Ocultar/Mostrar Header en Móvil
				if (window.innerWidth <= 768) {
					if (scrollTop > lastScrollTop && scrollTop > scrollThreshold) {
						header.style.transform = 'translateY(-100%)';
					} else {
						header.style.transform = 'translateY(0)';
					}
					lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
				} else {
					header.style.transform = 'translateY(0)';
				}

				// 2. Lógica del botón "Volver Arriba" con inactividad
				if (scrollTop > 20) {
					// Mostramos la flecha al mover la pantalla
					scrollTopBtn.classList.add('visible');

					// Limpiamos el temporizador anterior para que no se apague antes de tiempo
					clearTimeout(scrollTimeout);

					// Programamos que se oculte tras 2 segundos (2000 milisegundos) de inactividad
					scrollTimeout = setTimeout(() => {
						scrollTopBtn.classList.remove('visible');
					}, 2000);
				} else {
					// Si estamos arriba del todo, se oculta inmediatamente
					scrollTopBtn.classList.remove('visible');
					clearTimeout(scrollTimeout);
				}
			});

			// Evento de clic para subir suavemente
			scrollTopBtn?.addEventListener('click', function() {
				window.scrollTo({
					top: 0,
					behavior: 'smooth'
				});
				scrollTopBtn.classList.remove('visible');
				clearTimeout(scrollTimeout);
			});
		</script>

	</body>
</html>

<style is:global>
	html, body {
		margin: 0;
		padding: 0;
		background-color: #ffffff; 
		color: #333333;
		font-family: 'Work Sans', sans-serif;
	}
	a {
		text-decoration: none !important;
		border: none !important;
	}

	/* Estilos del Menú de Navegación */
	.main-nav {
		display: flex;
		justify-content: center;
		gap: 25px;
		flex-wrap: wrap;
		font-family: 'Work Sans', sans-serif;
		font-size: 18px;
		font-weight: normal;
		font-style: italic;
		border-top: none;
		border-bottom: none;
		width: 80%;
		max-width: 900px;
		padding: 4px 0 1px 0;
	}

	/* ----------------------------------------------------
	   BOTÓN FLOTANTE VOLVER ARRIBA (Con desvanecimiento)
	   ---------------------------------------------------- */
	#scroll-to-top {
		position: fixed;
		bottom: 25px;
		right: 25px;
		z-index: 999;
		width: 45px;
		height: 45px;
		background-color: #000000;
		color: #ffffff;
		border: none;
		border-radius: 50%;
		font-size: 22px;
		font-weight: bold;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.4s ease, visibility 0.4s ease, transform 0.2s ease;
	}

	#scroll-to-top.visible {
		opacity: 0.85;
		visibility: visible;
	}

	#scroll-to-top:hover {
		opacity: 1;
		transform: scale(1.1);
	}

	#scroll-to-top:active {
		transform: scale(0.95);
	}

	/* Estilos adaptativos del Footer Compacto */
	.main-footer {
		margin-top: 5px;
		padding: 10px 20px 12px 20px;
		font-family: 'Work Sans', sans-serif;
		font-size: 0.85rem;
		font-style: italic;
		color: #666666;
		display: flex;
		justify-content: center;
		width: 100%;
		box-sizing: border-box;
	}

	.footer-content {
		display: flex;
		flex-direction: row;
		justify-content: center;
		gap: 30px;
		width: 100%;
		max-width: 680px;
	}

	.footer-col-left {
		width: 190px;
		flex-shrink: 0;
	}

	.footer-col-right {
		width: 450px;
	}

	.footer-phrase-1 {
		margin: 0 0 6px 0;
		color: #222222;
		font-size: 15px;
		font-style: italic;
		font-weight: normal;
		line-height: 1.3;
	}

	.footer-phrase-2 {
		margin: 0 0 8px 0;
		color: #b0b0b0;
		font-size: 15px;
		font-style: italic;
		font-weight: normal;
		line-height: 1.3;
	}

	.footer-icons {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
		align-items: center;
	}

	/* 📱 ADAPTABILIDAD MÓVIL */
	@media (max-width: 768px) {
		.main-nav {
			gap: 12px 18px;
			font-size: 16px;
			width: 100%;
		}

		#scroll-to-top {
			bottom: 20px;
			right: 18px;
			width: 48px;
			height: 48px;
			font-size: 24px;
		}

		.main-footer {
			padding: 8px 15px 12px 15px;
		}

		.footer-content {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 10px;
		}

		.footer-col-left {
			width: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.footer-col-right {
			width: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.footer-icons {
			justify-content: center;
		}
	}
</style>

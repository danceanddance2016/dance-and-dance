---
// Layout.astro - Estructura definitiva de Dance & Dance
const { 
  title, 
  description = "Dance & Dance - 100% Dance Music. Eurodance · Trance · Techno · House · Pop ··· 90s - Today",
  image = "/favicon.jpg",
  cardType = "summary",
  lang = "en" // <--- ¡Añade esta línea aquí para que la variable lang exista!
} = Astro.props;

const siteURL = Astro.site ?? new URL(Astro.url.origin);
const pageTitle = title ? `${title} | Dance & Dance` : "Dance & Dance | 100% Dance Music";
const canonicalURL = new URL(Astro.url.pathname, siteURL).href;
const imageURL = new URL(image, siteURL).href;

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Dance & Dance",
  url: "https://danceanddance.vercel.app/",
};
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- 🔑 ETIQUETA DE VERIFICACIÓN DE GOOGLE SEARCH CONSOLE -->
		<meta name="google-site-verification" content="PqCOixvXK5qyn9U117IhCMtfPJ3QaspZUzqJ261vKxI" />
		<link rel="icon" type="image/png" href="/favicon.png" />

		<!-- 🔍 METADATOS SEO BÁSICOS -->
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- 🌐 OPEN GRAPH (Para WhatsApp, Facebook, LinkedIn, etc.) -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Dance & Dance" />
		<meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />

		<!-- 🐦 TWITTER CARDS -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<!-- Carga completa y real de Work Sans -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
	</head>
	<body>

		<!-- CABECERA INTELIGENTE -->
		<header id="main-header">
			<div class="header-top-row">
				<div class="logo-container">
					<a href="/">
						<img 
							src="/Banner-Superior-DD.png" 
							alt="Dance & Dance - Banner Superior" 
							class="header-banner"
						/>
					</a>
				</div>

				<!-- BOTÓN HAMBURGUESA (A la derecha en móviles) -->
				<button id="menu-toggle" class="menu-toggle" aria-label="Abrir menú">
					<span class="bar"></span>
					<span class="bar"></span>
					<span class="bar"></span>
				</button>
			</div>

			<!-- MENÚ DE NAVEGACIÓN -->
			<nav id="main-nav" class="main-nav">
				<a href="/" style="color: #000000;">Home</a>
				<a href="/compilations" style="color: #000000;">Compilations</a>
				<a href="/playlists" style="color: #000000;">Playlists</a>
				<a href="/artist-compilations" style="color: #000000;">Artist Compilations</a>
				<a href="/all-albums" style="color: #000000;">All Albums</a>
				<a href="/more-playlists" style="color: #000000;">+ Playlists</a>
				<a href="/news" style="color: #000000;">News</a>
			</nav>
		</header>

		<!-- CONTENIDO PRINCIPAL -->
		<main style="max-width: 1200px; margin: 0 auto; padding: 5px 40px 5px 40px;">
			<slot />
		</main>

		<!-- BOTÓN FLOTANTE "VOLVER ARRIBA" -->
		<button id="scroll-to-top" aria-label="Volver arriba" title="Volver arriba">
			&#8593;
		</button>

		<!-- PIE DE PÁGINA -->
		<footer class="main-footer">
			<div class="footer-content">
				<div class="footer-col-left">
					<p style="margin: 0 0 8px 0;">
						<img src="/D&D-Logo.png" alt="Dance & Dance Logo" style="max-width: 110px; width: 100%; height: auto; display: block;" />
					</p>
					<p style="margin: 0; white-space: nowrap;">&copy; 2016 - 2026 by Dance & Dance.</p>
				</div>
				
				<div class="footer-col-right">
					<p class="footer-phrase-1">
						Dance & Dance <span style="color: #ff1616;">100%</span> Dance Music
					</p>

					<p class="footer-phrase-2">
						Eurodance · Trance · Techno · House · Pop ··· 90s - Today
					</p>
					
					<div class="footer-icons">
						<a href="https://open.spotify.com/user/danceanddance2016?si=4cb3eb62b3a24436" target="_blank" title="Spotify">
							<img src="/images/Spotify_Primary_Logo_RGB_Green (1).png" alt="Spotify" style="height: 30px; width: 30px; object-fit: contain; display: block;" />
						</a>
						<a href="https://www.deezer.com/es/profile/1501757982" target="_blank" title="Deezer">
							<img src="/images/Heart Icon.png" alt="Deezer" style="height: 30px; width: 30px; object-fit: contain; display: block;" />
						</a>
						<a href="https://music.youtube.com/channel/UC__u35D1H0NgsgPHb6OnPZQ?feature=share" target="_blank" title="YouTube Music">
							<img src="/images/YouTubeMusic_Logo.png" alt="YouTube Music" style="height: 30px; width: 30px; object-fit: contain; display: block;" />
						</a>
						<a href="https://www.youtube.com/channel/UC__u35D1H0NgsgPHb6OnPZQ/featured" target="_blank" title="YouTube">
							<img src="/images/logo-mini-youtube.png" alt="YouTube" style="height: 30px; width: 30px; object-fit: contain; display: block;" />
						</a>
						<a href="https://www.facebook.com/Dance-Dance-402811826731310/" target="_blank" title="Facebook">
							<img src="/images/Facebook_Logo_Primary.png" alt="Facebook" style="height: 30px; width: 30px; object-fit: contain; display: block;" />
						</a>
						<a href="https://twitter.com/Dance_Y_Dance" target="_blank" title="X">
							<img src="/images/logo-black.png" alt="X" style="height: 28px; width: 28px; object-fit: contain; display: block;" />
						</a>
						<a href="https://www.instagram.com/danceanddance2016/" target="_blank" title="Instagram">
							<img src="/images/Instagram_logo.png" alt="Instagram" style="height: 30px; width: 30px; object-fit: contain; border-radius: 8px; display: block;" />
						</a>
						<a href="https://soundcloud.com/dance-dance-844343366" target="_blank" title="SoundCloud">
							<img src="/images/soudcloudd_Favicon Colors Black on orange.png" alt="SoundCloud" style="height: 30px; width: 30px; object-fit: contain; border-radius: 6px; display: block;" />
						</a>
					</div>
				</div>
			</div>
		</footer>

		<!-- SCRIPTS INTELIGENTES GLOBALES -->
		<script>
			let lastScrollTop = 0;
			const scrollThreshold = 50;
			let scrollTimeout: any;

			function initDanceHeader() {
				const header = document.getElementById('main-header');
				const nav = document.getElementById('main-nav');
				const menuToggle = document.getElementById('menu-toggle');
				const scrollTopBtn = document.getElementById('scroll-to-top');

				// 1. Lógica Menú Hamburguesa en Móvil
				if (menuToggle && nav) {
					menuToggle.onclick = (e) => {
						e.stopPropagation();
						nav.classList.toggle('active');
						menuToggle.classList.toggle('open');
					};

					nav.querySelectorAll('a').forEach(link => {
						link.onclick = () => {
							nav.classList.remove('active');
							menuToggle.classList.remove('open');
						};
					});
				}

				// 2. Acción del botón "Volver Arriba"
				if (scrollTopBtn) {
					scrollTopBtn.onclick = () => {
						window.scrollTo({
							top: 0,
							behavior: 'smooth'
						});
						scrollTopBtn.classList.remove('visible');
						clearTimeout(scrollTimeout);
					};
				}
			}

			// 3. Listener Global del Scroll para la cabecera y el botón de subir
			window.addEventListener('scroll', () => {
				const header = document.getElementById('main-header');
				const nav = document.getElementById('main-nav');
				const scrollTopBtn = document.getElementById('scroll-to-top');
				let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

				// Ocultar/Mostrar Header en Móvil
				if (window.innerWidth <= 768 && header) {
					if (!nav?.classList.contains('active')) {
						if (scrollTop > lastScrollTop && scrollTop > scrollThreshold) {
							header.style.transform = 'translateY(-100%)';
						} else {
							header.style.transform = 'translateY(0)';
						}
					}
					lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
				} else if (header) {
					header.style.transform = 'translateY(0)';
				}

				// Lógica de visibilidad del botón "Volver Arriba"
				if (scrollTopBtn) {
					if (scrollTop > 20) {
						scrollTopBtn.classList.add('visible');
						clearTimeout(scrollTimeout);
						scrollTimeout = setTimeout(() => {
							scrollTopBtn.classList.remove('visible');
						}, 2000);
					} else {
						scrollTopBtn.classList.remove('visible');
						clearTimeout(scrollTimeout);
					}
				}
			});

			// Inicializar al cargar la página
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initDanceHeader);
			} else {
				initDanceHeader();
			}

			// Soporte para transiciones de Astro
			document.addEventListener('astro:page-load', initDanceHeader);
		</script>

	</body>
</html>

<style is:global>
	html, body {
		margin: 0;
		padding: 0;
		background-color: #ffffff;
		color: #333333;
		font-family: 'Work Sans', sans-serif;
	}
	a {
		text-decoration: none !important;
		border: none !important;
	}

	/* Header */
	#main-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 12px 20px 8px 20px;
		background-color: #ffffff;
		position: sticky;
		top: 0;
		z-index: 1000;
		transition: transform 0.3s ease-in-out;
	}

	.header-top-row {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
	}

	.logo-container {
		text-align: center;
		width: 100%;
	}

	.header-banner {
		max-width: 550px;
		width: 100%;
		height: auto;
		display: block;
		margin: 0 auto;
	}

	/* Estilos del Menú de Navegación (PC) */
	.main-nav {
		display: flex;
		justify-content: center;
		gap: 25px;
		flex-wrap: wrap;
		font-family: 'Work Sans', sans-serif;
		font-size: 18px;
		font-weight: normal;
		font-style: italic;
		width: 80%;
		max-width: 900px;
		padding: 4px 0 1px 0;
	}

	/* Botón Hamburguesa (Oculto en PC) */
	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: space-between;
		width: 28px;
		height: 20px;
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0;
		z-index: 1001;
		flex-shrink: 0;
	}

	.menu-toggle .bar {
		width: 100%;
		height: 3px;
		background-color: #000000;
		border-radius: 2px;
		transition: all 0.3s ease;
	}

	/* Transformación a 'X' al abrir */
	.menu-toggle.open .bar:nth-child(1) {
		transform: translateY(8.5px) rotate(45deg);
	}
	.menu-toggle.open .bar:nth-child(2) {
		opacity: 0;
	}
	.menu-toggle.open .bar:nth-child(3) {
		transform: translateY(-8.5px) rotate(-45deg);
	}

	/* BOTÓN FLOTANTE VOLVER ARRIBA */
	#scroll-to-top {
		position: fixed;
		bottom: 25px;
		right: 25px;
		z-index: 999;
		width: 45px;
		height: 45px;
		background-color: #000000;
		color: #ffffff;
		border: none;
		border-radius: 50%;
		font-size: 22px;
		font-weight: bold;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.4s ease, visibility 0.4s ease, transform 0.2s ease;
	}

	#scroll-to-top.visible {
		opacity: 0.85;
		visibility: visible;
	}

	#scroll-to-top:hover {
		opacity: 1;
		transform: scale(1.1);
	}

	#scroll-to-top:active {
		transform: scale(0.95);
	}

	/* Footer */
	.main-footer {
		margin-top: 5px;
		padding: 10px 20px 12px 20px;
		font-family: 'Work Sans', sans-serif;
		font-size: 0.85rem;
		font-style: italic;
		color: #666666;
		display: flex;
		justify-content: center;
		width: 100%;
		box-sizing: border-box;
	}

	.footer-content {
		display: flex;
		flex-direction: row;
		justify-content: center;
		gap: 30px;
		width: 100%;
		max-width: 680px;
	}

	.footer-col-left {
		width: 190px;
		flex-shrink: 0;
	}

	.footer-col-right {
		width: 450px;
	}

	.footer-phrase-1 {
		margin: 0 0 6px 0;
		color: #222222;
		font-size: 15px;
		font-style: italic;
		font-weight: normal;
		line-height: 1.3;
	}

	.footer-phrase-2 {
		margin: 0 0 8px 0;
		color: #b0b0b0;
		font-size: 15px;
		font-style: italic;
		font-weight: normal;
		line-height: 1.3;
	}

	.footer-icons {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
		align-items: center;
	}

	/* 📱 ADAPTABILIDAD MÓVIL */
	@media (max-width: 768px) {
		#main-header {
			padding: 8px 15px 8px 15px;
		}

		.header-top-row {
			justify-content: space-between;
			gap: 10px;
			position: relative;
		}

		.logo-container {
			flex: 1;
			display: flex;
			justify-content: center;
			padding-left: 0;
			text-align: center;
		}

		.header-banner {
			max-width: 250px;
			margin: 0;
		}

		.menu-toggle {
			display: flex;
		}

		.main-nav {
			display: none;
			flex-direction: column;
			align-items: center;
			width: 100%;
			padding: 15px 0;
			gap: 15px;
			font-size: 18px;
			background-color: #ffffff;
			border-bottom: 1px solid #eeeeee;
		}

		.main-nav.active {
			display: flex;
		}

		#scroll-to-top {
			bottom: 20px;
			right: 18px;
			width: 48px;
			height: 48px;
			font-size: 24px;
		}

		.main-footer {
			padding: 8px 15px 12px 15px;
		}

		.footer-content {
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 10px;
		}

		.footer-col-left {
			width: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.footer-col-right {
			width: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.footer-icons {
			justify-content: center;
		}
	}
</style>
